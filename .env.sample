# Copy this file to .env and adjust as needed before running manage.py.
# Provide real secrets via environment variables in your deployment platform
# rather than committing them to source control.

# Core Django settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True

# Application database
# Default is SQLite for local development; no settings required.
# To use PostgreSQL, set DATABASE_ENGINE=postgres and provide the PG* vars below.
# Django also accepts legacy aliases PG_HOST, PG_PORT, PG_USER,
# PG_PASSWORD and PG_DBNAME; prefer the canonical names below.
# DATABASE_ENGINE=postgres
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
# PGSSLMODE=prefer

# Respondent bank source database (PostgreSQL)
# Uncomment and set only when the respondent bank lives in a different DB.
# If omitted, the import uses the same PG* values as the application DB.
# RESPONDENT_DB_HOST=
# RESPONDENT_DB_PORT=5432
# RESPONDENT_DB_USER=
# RESPONDENT_DB_PASSWORD=
# RESPONDENT_DB_NAME=
